#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_PORTUGUESE, SUBLANG_PORTUGUESE_BRAZILIAN

IDI_APP_ICON            ICON                    "resources\\app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "3º Sgt Rolandi - H Mil Resende"
            VALUE "FileDescription", "KRISTAL LABORATORIAL"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "KRISTAL LABORATORIAL"
            VALUE "LegalCopyright", "Desenvolvedor: 3º Sgt Rolandi - H Mil Resende"
            VALUE "OriginalFilename", "kristal_laboratorial.exe"
            VALUE "ProductName", "KRISTAL LABORATORIAL"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END

#endif
